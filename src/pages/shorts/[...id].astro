---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleLinkEmbed from "../../components/article/ArticleLinkEmbed.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("shorts", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"shorts"> }
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.summary}
  publishDate={entry.data.publishedAt}
  tag="Short"
  pathname={Astro.url.pathname}
>
  <Content components={{ LinkEmbed: ArticleLinkEmbed }} />
</ArticleLayout>
