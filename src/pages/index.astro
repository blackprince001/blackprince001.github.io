---
import { getCollection } from "astro:content";
import ArrowRightIcon from "../components/astro/ArrowRightIcon.astro";
import ArrowUpRightIcon from "../components/astro/ArrowUpRightIcon.astro";
import ProjectFeature from "../components/astro/ProjectFeature.astro";
import SectionHeading from "../components/astro/SectionHeading.astro";
import TagPill from "../components/astro/TagPill.astro";
import BlueprintNoiseField from "../components/astro/BlueprintNoiseField.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects, publications } from "../lib/site-data";

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);
const recentPublications = [...publications]
  .sort((a, b) => b.year - a.year)
  .slice(0, 5);
const selectedProjectNames = new Set([
  "Flowbench — One Flow, Every Test Profile",
  "Oware Engine and a Ladder of RL Agents",
  "Real-Time Traffic Density Estimation",
  "Humanoid Balancing Policy with MjLab",
]);
const selectedProjects = projects.filter((project) =>
  selectedProjectNames.has(project.name),
);
const date = new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<BaseLayout>
  <div class="home">
    <div class="home-column">
      <section id="intro" class="hero" aria-labelledby="intro-title">
        <div class="identity-mark" aria-hidden="true">PK</div>
        <h1 id="intro-title">Hi. I’m Prince.</h1>
        <div class="intro-copy">
          <p>
            I’m a systems engineer and ai/robotics researcher. I build
            autonomous systems and study the places where machine learning,
            software engineering, and design meet.
          </p>
          <p>
            This site is my working archive: research notes, open-source
            systems, long-form essays, and manuscripts shaped by the questions
            I’m currently following.
          </p>
          <p>
            At the moment, I’m teaching a practical course on robotics and
            continuing work across robot learning, perception, and
            infrastructure for intelligent systems.
          </p>
        </div>
        <div class="hero-actions">
          <a
            class="text-link"
            href="https://robotics-course-458.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
            ><span>Robotics course</span><ArrowUpRightIcon /></a
          >
          <a class="text-link" href="/blog"
            ><span>Read the journal</span><ArrowRightIcon /></a
          >
          <a class="text-link" href="/projects"
            ><span>View all projects</span><ArrowRightIcon /></a
          >
        </div>
      </section>

      <section
        class="blueprint-field"
        aria-label="Interactive engineering noise field"
      >
        <BlueprintNoiseField />
        <div class="blueprint-field__label" aria-hidden="true">
          <span>VECTOR FIELD</span>
          <span>MOVE ACROSS THE FIELD</span>
        </div>
      </section>

      <section
        id="writing"
        class="home-section"
        aria-labelledby="writing-title"
      >
        <SectionHeading
          index="01"
          eyebrow="Journal"
          title="Recent writing"
          href="/blog"
          headingId="writing-title"
        />
        <div class="entry-list">
          {
            writing.map((entry) => (
              <a class="entry-row" href={`/blog/${entry.id}`}>
                <span class="entry-date">
                  {date.format(entry.data.publishDate)}
                </span>
                <span class="entry-main">
                  <span class="entry-title">{entry.data.title}</span>
                  <TagPill label={entry.data.tag} />
                </span>
                <span class="entry-arrow" aria-hidden="true">
                  <ArrowUpRightIcon />
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section
        id="manuscripts"
        class="home-section"
        aria-labelledby="manuscripts-title"
      >
        <SectionHeading
          index="02"
          eyebrow="Research"
          title="Recent manuscripts"
          href="/publications"
          headingId="manuscripts-title"
        />
        <div class="manuscript-list">
          {
            recentPublications.map((publication) => (
              <a
                class="manuscript-row"
                href={publication.pdf ?? publication.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                {publication.preview && (
                  <span class="manuscript-preview" aria-hidden="true">
                    <img
                      src={publication.preview}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="600"
                      height="800"
                    />
                  </span>
                )}
                <span class="manuscript-copy">
                  <span class="manuscript-year">{publication.year}</span>
                  <strong>{publication.title}</strong>
                  <small>
                    {publication.domain ?? publication.authors.join(", ")}
                  </small>
                </span>
                <span class="manuscript-icon" aria-hidden="true">
                  <span>PDF</span>
                  <ArrowUpRightIcon />
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <section id="work" class="home-section" aria-labelledby="work-title">
        <SectionHeading
          index="03"
          eyebrow="Systems"
          title="Selected work"
          href="/projects"
          headingId="work-title"
        />
        <div class="project-list">
          {
            selectedProjects.map((project, index) => (
              <ProjectFeature project={project} index={index} />
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
