---
import TagPill from "../components/astro/TagPill.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { reading } from "../lib/site-data";

const statusLabel = {
  reading: "Reading",
  finished: "Finished",
  "want-to-read": "Queued",
};

function localCoverPath(cover: string) {
  const id = new URL(cover).pathname.match(/\/isbn\/([^/]+)-L\.jpg$/)?.[1];
  return id ? `/images/books/${id}.webp` : cover;
}
---

<BaseLayout title="Reading — blackprince" description="Books shaping my work across engineering, science, fiction, and philosophy.">
  <article class="collection-page">
    <header class="collection-header">
      <p class="section-index">Working library</p>
      <h1>Reading</h1>
      <p>Books shaping my work across engineering, science, fiction, philosophy, and the study of mind.</p>
    </header>
    <nav class="reading-nav" aria-label="Reading categories">
      {reading.categories.map((category) => <TagPill label={category.label} href={`#${category.id}`} />)}
    </nav>
    {reading.categories.map((category) => {
      const books = reading.books.filter((book) => book.category === category.id);
      return (
        <section id={category.id} class="reading-section" aria-labelledby={`${category.id}-title`}>
          <div>
            <h2 id={`${category.id}-title`}>{category.label}</h2>
            <p>{category.description}</p>
          </div>
          <div class="book-grid">
            {books.map((book) => (
              <article class="book-entry">
                <img
                  src={localCoverPath(book.cover)}
                  alt=""
                  width="240"
                  height="360"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <TagPill label={statusLabel[book.status]} />
                  <h3>{book.title}</h3>
                  <p>{book.author}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </article>
</BaseLayout>

<script>
  if ("serviceWorker" in navigator) {
    addEventListener("load", () => navigator.serviceWorker.register("/sw.js"));
  }
</script>
