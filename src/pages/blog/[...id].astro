---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ArticleExample from "../../components/article/ArticleExample.astro";
import ArticleFigure from "../../components/article/ArticleFigure.astro";
import ArticleSidenote from "../../components/article/ArticleSidenote.astro";
import ArticleCodeSnippet from "../../components/article/ArticleCodeSnippet.astro";
import VideoPlayer from "../../components/article/VideoPlayer.astro";
import ArticlePreviewLink from "../../components/article/ArticlePreviewLink.astro";
import ArticleSuggestion from "../../components/article/ArticleSuggestion.astro";import AxisAngleDemo from "../../components/article/islands/AxisAngleDemoIsland.astro";
import GoRunner from "../../components/article/islands/GoRunnerIsland.astro";
import HelloFx from "../../components/article/islands/HelloFxIsland.astro";
import InequalitiesExample from "../../components/article/islands/InequalitiesExampleIsland.astro";
import MeshRenderSwitch from "../../components/article/islands/MeshRenderIsland.astro";
import PythonRunner from "../../components/article/islands/PythonRunnerIsland.astro";
import Quiz from "../../components/article/islands/QuizIsland.astro";
import RotationFrameDemo from "../../components/article/islands/RotationFrameDemoIsland.astro";
import RustRunner from "../../components/article/islands/RustRunnerIsland.astro";
import ScrewMotionDemo from "../../components/article/islands/ScrewMotionDemoIsland.astro";
import Sigmoid from "../../components/article/islands/SigmoidIsland.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { estimateReadingTime, type ArticleDiscoveryLink } from "../../lib/content-presentation";

export async function getStaticPaths() {
  const entries = (await getCollection("writing", ({ data }) => !data.draft))
    .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

  return entries.map((entry, index) => {
    const adjacent = [
      entries[index + 1] && {
        href: `/blog/${entries[index + 1].id}`,
        label: "Older",
        title: entries[index + 1].data.title,
      },
      entries[index - 1] && {
        href: `/blog/${entries[index - 1].id}`,
        label: "Newer",
        title: entries[index - 1].data.title,
      },
    ].filter(Boolean) as ArticleDiscoveryLink[];
    const adjacentIds = new Set(adjacent.map((link) => link.href));
    const related = entries
      .filter((candidate) =>
        candidate.id !== entry.id
        && candidate.data.tag === entry.data.tag
        && !adjacentIds.has(`/blog/${candidate.id}`))
      .slice(0, Math.max(0, 3 - adjacent.length))
      .map((candidate) => ({
        href: `/blog/${candidate.id}`,
        label: `More in ${entry.data.tag}`,
        title: candidate.data.title,
      }));

    return {
      params: { id: entry.id },
      props: { entry, discoveryLinks: [...adjacent, ...related] },
    };
  });
}

interface Props {
  entry: CollectionEntry<"writing">;
  discoveryLinks: ArticleDiscoveryLink[];
}
const { entry, discoveryLinks } = Astro.props;
const { Content, headings } = await render(entry);
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  tags={[entry.data.tag]}
  headings={headings}
  pathname={Astro.url.pathname}
  readingTime={entry.data.readingTime ?? estimateReadingTime(entry.body)}
  discoveryLinks={discoveryLinks}
>
  <Content components={{
    Figure: ArticleFigure,
    Example: ArticleExample,
    Sidenote: ArticleSidenote,
    AutoNumberedSidenote: ArticleSidenote,
    MarginNoteMarker: ArticleSidenote,
    AutoNumberedMarginNote: ArticleSidenote,
    BlogSuggestion: ArticleSuggestion,
    PreviewLink: ArticlePreviewLink,
    CodeSnippet: ArticleCodeSnippet,
    VideoPlayer,
    MeshRenderSwitch,
    HelloFx,
    InequalitiesExample,
    Sigmoid,
    GoRunner,
    PythonRunner,
    RustRunner,
    RotationFrameDemo,
    AxisAngleDemo,
    ScrewMotionDemo,
    Quiz,
  }} />
</ArticleLayout>
