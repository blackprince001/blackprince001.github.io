---
interface Props {
  src: string;
  alt: string;
  imageIndex?: number;
  loading?: "eager" | "lazy";
}

const { src, alt, imageIndex, loading = "lazy" } = Astro.props;
const videoPattern = /\.(mp4|webm|mov|m4v|ogv)(\?.*)?$/i;
const youtubeMatch = src.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/);
const youtubeId = youtubeMatch?.[1];
const isVideo = videoPattern.test(src);
const videoPosters: Record<string, string> = {
  "/traffic-pipeline/rtdetr-l_clip1.mp4": "/video-posters/rtdetr-l_clip1.mp4.png",
  "/robotics/no_policy.mp4": "/video-posters/no_policy.mp4.png",
  "/robotics/wobbly.mp4": "/video-posters/wobbly.mp4.png",
  "/robotics/standing_policy.mp4": "/video-posters/standing_policy.mp4.png",
};
const poster = videoPosters[src];
---

{youtubeId ? (
  <iframe
    class="project-media-tile"
    src={`https://www.youtube-nocookie.com/embed/${youtubeId}?rel=0&modestbranding=1`}
    title={alt}
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
  ></iframe>
) : isVideo ? (
  <video class="project-media-tile" src={src} controls muted playsinline preload="none" poster={poster} aria-label={alt}></video>
) : (
  <button class="project-media-tile project-media-tile--image" type="button" data-project-image={imageIndex} aria-label={`Open ${alt} fullscreen`}>
    <img src={src} alt={alt} loading={loading} decoding="async" />
  </button>
)}
