---
import type { Project } from "../../lib/content-model";
import ArrowUpRightIcon from "./ArrowUpRightIcon.astro";
import TagPill from "./TagPill.astro";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const media = project.images ?? [];
const videoPattern = /\.(mp4|webm|mov|m4v|ogv)(\?.*)?$/i;
const youtubePattern = /(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{6,})/;
const videoPosters: Record<string, string> = {
  "/traffic-pipeline/rtdetr-l_clip1.mp4": "/video-posters/rtdetr-l_clip1.mp4.png",
  "/robotics/no_policy.mp4": "/video-posters/no_policy.mp4.png",
  "/robotics/wobbly.mp4": "/video-posters/wobbly.mp4.png",
  "/robotics/standing_policy.mp4": "/video-posters/standing_policy.mp4.png",
};
type GalleryItem =
  | { kind: "image"; src: string }
  | { kind: "video"; src: string; poster?: string }
  | { kind: "youtube"; src: string; id: string };

const gallery: GalleryItem[] = media.map((src) => {
  const youtubeId = src.match(youtubePattern)?.[1];
  if (youtubeId) return { kind: "youtube", src, id: youtubeId };
  if (videoPattern.test(src)) return { kind: "video", src, poster: videoPosters[src] };
  return { kind: "image", src };
});
const stackMedia = gallery.slice(0, 3);
const stackThumb = (item: GalleryItem) =>
  item.kind === "image" ? item.src
  : item.kind === "video" ? item.poster ?? item.src
  : `https://i.ytimg.com/vi/${item.id}/hqdefault.jpg`;
const paragraphs = Array.isArray(project.description) ? project.description : [project.description];
const slug = project.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
---

<article id={slug} class="project-feature project-feature--detail" data-project-gallery data-project-items={JSON.stringify(gallery)}>
  <div class:list={["project-detail-grid", gallery.length === 0 && "project-detail-grid--copy-only"]}>
    <div class="project-detail-copy">
      <div class="project-title-row">
        <h3>{project.name}</h3>
        <span>{project.date}</span>
      </div>
      <div class="tag-list project-detail-tags">
        {project.tags.map((tag) => <TagPill label={tag} />)}
      </div>
      <div class="project-detail-description">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="project-links project-detail-links">
        {project.links.map((link) => (
          <a
            class="text-link"
            href={link.url}
            target={link.url.startsWith("http") ? "_blank" : undefined}
            rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined}
          >
            <span>{link.label}</span>
            <ArrowUpRightIcon />
          </a>
        ))}
      </div>
    </div>
    {gallery.length > 0 && (
      <div class="project-side-media">
        <button
          class:list={["project-media-stack", stackMedia.length > 1 && "project-media-stack--stacked"]}
          type="button"
          data-project-image={0}
          aria-label={`Open ${project.name} gallery (${gallery.length} items)`}
        >
          <span class="project-media-stack__cards" aria-hidden="true">
            {stackMedia.map((item) => (
              <img
                src={stackThumb(item)}
                alt=""
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                data-kind={item.kind}
              />
            ))}
          </span>
          <span class="project-media-stack__badge">View {gallery.length}</span>
        </button>
      </div>
    )}
  </div>

  {gallery.length > 0 && (
    <dialog class="project-lightbox" aria-label={`${project.name} media viewer`}>
      <div class="project-lightbox__frame">
        <button class="project-lightbox__close" type="button" data-lightbox-close aria-label="Close viewer">Close</button>
        <button class="project-lightbox__previous" type="button" data-lightbox-previous aria-label="Previous item">←</button>
        <div class="project-lightbox__stage"></div>
        <button class="project-lightbox__next" type="button" data-lightbox-next aria-label="Next item">→</button>
        <p aria-live="polite"></p>
      </div>
    </dialog>
  )}
</article>

<script>
  document.querySelectorAll<HTMLElement>("[data-project-gallery]").forEach((galleryRoot) => {
    const dialog = galleryRoot.querySelector<HTMLDialogElement>(".project-lightbox");
    const stage = dialog?.querySelector<HTMLElement>(".project-lightbox__stage");
    const status = dialog?.querySelector<HTMLParagraphElement>("p");
    const triggers = [...galleryRoot.querySelectorAll<HTMLButtonElement>("[data-project-image]")]
      .filter((trigger) => Number(trigger.dataset.projectImage) >= 0);
    let items: { kind: string; src: string; poster?: string; id?: string }[] = [];
    let activeIndex = 0;

    try {
      items = JSON.parse(galleryRoot.dataset.projectItems ?? "[]");
    } catch {
      items = [];
    }

    if (!dialog || !stage || !status || items.length === 0) return;

    const projectName = galleryRoot.querySelector("h3")?.textContent ?? "Project";
    const stopPlayback = () => {
      stage.querySelector("video")?.pause();
      stage.replaceChildren();
    };

    const renderItem = () => {
      stopPlayback();
      const item = items[activeIndex];
      const label = `${projectName} gallery item ${activeIndex + 1}`;
      if (item.kind === "video") {
        const video = document.createElement("video");
        video.src = item.src;
        if (item.poster) video.poster = item.poster;
        video.controls = true;
        video.playsInline = true;
        video.preload = "metadata";
        video.setAttribute("aria-label", label);
        stage.append(video);
        video.play().catch(() => {});
      } else if (item.kind === "youtube" && item.id) {
        const iframe = document.createElement("iframe");
        iframe.src = `https://www.youtube-nocookie.com/embed/${item.id}?autoplay=1&rel=0&modestbranding=1`;
        iframe.title = label;
        iframe.allow = "accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
        iframe.allowFullscreen = true;
        stage.append(iframe);
      } else {
        const image = document.createElement("img");
        image.src = item.src;
        image.alt = label;
        stage.append(image);
      }
      status.textContent = `Item ${activeIndex + 1} of ${items.length}`;
    };

    const showItem = (index: number) => {
      activeIndex = (index + items.length) % items.length;
      renderItem();
    };

    triggers.forEach((trigger) => trigger.addEventListener("click", () => {
      showItem(Number(trigger.dataset.projectImage));
      dialog.showModal();
    }));
    dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector<HTMLButtonElement>("[data-lightbox-previous]")?.addEventListener("click", () => showItem(activeIndex - 1));
    dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]")?.addEventListener("click", () => showItem(activeIndex + 1));
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("close", stopPlayback);
  });
</script>
