---
interface Props {
  label: string;
  href?: string;
  active?: boolean;
  button?: boolean;
  dataTag?: string;
  class?: string;
}

const {
  label,
  href,
  active = false,
  button = false,
  dataTag,
  class: className = "",
} = Astro.props;
const classes = `tag-pill ${className}`.trim();
---

{href ? (
  <a class={classes} href={href} aria-current={active ? "page" : undefined}>
    {label}
  </a>
) : button ? (
  <button class={classes} type="button" aria-pressed={active} data-blog-tag={dataTag}>
    {label}
  </button>
) : (
  <span class={classes}>
    {label}
  </span>
)}
