---
import ArrowUpRightIcon from "./ArrowUpRightIcon.astro";
import { RepoCard } from "../repos/repo-card";
import { getLanguageColor, type GitHubRepoData } from "../repos/github";

const USER = "blackprince001";
const PER_PAGE = 6;

interface ApiRepo {
  name: string;
  description: string | null;
  stargazers_count: number;
  forks_count: number;
  open_issues_count: number;
  language: string | null;
  license: { spdx_id: string } | null;
  topics: string[];
  fork: boolean;
  archived: boolean;
  homepage: string | null;
  pushed_at: string | null;
  created_at: string;
}

interface CardEntry {
  data: GitHubRepoData;
  createdAt: number;
}

let entries: CardEntry[] = [];
let failed = false;

try {
  const response = await fetch(`https://api.github.com/users/${USER}/repos?per_page=100&sort=created`, {
    headers: {
      Accept: "application/vnd.github+json",
      ...(process.env.GITHUB_TOKEN ? { Authorization: `Bearer ${process.env.GITHUB_TOKEN}` } : {}),
    },
  });
  if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
  const repos = (await response.json()) as ApiRepo[];
  entries = repos
    .filter((repo) => !repo.fork)
    .map((repo) => ({
      data: {
        fullName: `${USER}/${repo.name}`,
        description: repo.description,
        language: repo.language,
        languageColor: repo.language ? getLanguageColor(repo.language) : null,
        stars: repo.stargazers_count ?? 0,
        forks: repo.forks_count ?? 0,
        openIssues: repo.open_issues_count ?? 0,
        license: repo.license?.spdx_id ?? null,
        topics: Array.isArray(repo.topics) ? repo.topics : [],
        updatedAt: repo.pushed_at,
        isFork: repo.fork ?? false,
        isArchived: repo.archived ?? false,
        homepage: repo.homepage || null,
      },
      createdAt: new Date(repo.created_at).valueOf(),
    }));
} catch {
  failed = true;
}

const pages = Math.max(1, Math.ceil(entries.length / PER_PAGE));
---

<section class="open-source" aria-labelledby="open-source-title" data-open-source>
  <header class="open-source__header">
    <div>
      <p class="section-index">Repository archive</p>
      <h2 id="open-source-title">Open source</h2>
    </div>
    <a class="text-link" href="https://github.com/blackprince001" target="_blank" rel="noopener noreferrer"><span>GitHub profile</span><ArrowUpRightIcon /></a>
  </header>

  {failed ? (
    <p class="open-source__status" role="status">Repositories could not be loaded right now.</p>
    <a class="text-link" href="https://github.com/blackprince001?tab=repositories" target="_blank" rel="noopener noreferrer"><span>Browse repositories on GitHub</span><ArrowUpRightIcon /></a>
  ) : (
    <div class="open-source__controls" role="group" aria-label="Sort open-source projects">
      <button type="button" data-sort="recent" aria-pressed="true">Recent</button>
      <button type="button" data-sort="stars" aria-pressed="false">Most stars</button>
    </div>
    <p class="open-source__status" role="status" aria-live="polite" data-status>
      {entries.length} public repositories, sorted by recency.
    </p>
    <div class="open-source__grid" data-grid>
      {entries.map((entry) => (
        <RepoCard
          size="lg"
          data={entry.data}
          data-created={String(entry.createdAt)}
          data-stars={String(entry.data.stars)}
        />
      ))}
    </div>
    <nav class="open-source__pagination" aria-label="Repository pages" data-pagination hidden={pages <= 1}>
      <button type="button" data-page="previous">← Previous</button>
      <span data-page-label></span>
      <button type="button" data-page="next">Next →</button>
    </nav>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-open-source]").forEach((root) => {
    const grid = root.querySelector<HTMLElement>("[data-grid]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const pagination = root.querySelector<HTMLElement>("[data-pagination]");
    const pageLabel = root.querySelector<HTMLElement>("[data-page-label]");
    const sortButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-sort]")];
    const previous = root.querySelector<HTMLButtonElement>("[data-page='previous']");
    const next = root.querySelector<HTMLButtonElement>("[data-page='next']");
    const perPage = 6;
    if (!grid || !status || !pagination || !pageLabel || !previous || !next) return;

    const cards = [...grid.querySelectorAll<HTMLElement>("[data-slot='repo-card']")];
    let sort: "recent" | "stars" = "recent";
    let page = 1;

    const render = () => {
      const sorted = [...cards].sort((a, b) => sort === "stars"
        ? Number(b.dataset.stars) - Number(a.dataset.stars)
        : Number(b.dataset.created) - Number(a.dataset.created));
      const pages = Math.max(1, Math.ceil(sorted.length / perPage));
      page = Math.min(page, pages);
      grid.replaceChildren(...sorted);
      sorted.forEach((card, index) => {
        card.hidden = index < (page - 1) * perPage || index >= page * perPage;
      });
      status.textContent = `${cards.length} public repositories, sorted by ${sort === "stars" ? "stars" : "recency"}.`;
      pagination.hidden = pages <= 1;
      pageLabel.textContent = `Page ${page} of ${pages}`;
      previous.disabled = page === 1;
      next.disabled = page === pages;
    };

    sortButtons.forEach((button) => button.addEventListener("click", () => {
      sort = button.dataset.sort === "stars" ? "stars" : "recent";
      page = 1;
      sortButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      render();
    }));
    previous.addEventListener("click", () => { page = Math.max(1, page - 1); render(); });
    next.addEventListener("click", () => { page += 1; render(); });

    render();
  });
</script>
