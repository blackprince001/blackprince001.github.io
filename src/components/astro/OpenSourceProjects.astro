<section class="open-source" aria-labelledby="open-source-title" data-open-source-projects>
  <header class="open-source__header">
    <div>
      <p class="section-index">Repository archive</p>
      <h2 id="open-source-title">Open source</h2>
    </div>
    <a class="text-link" href="https://github.com/blackprince001" target="_blank" rel="noopener noreferrer">GitHub profile <span aria-hidden="true">↗</span></a>
  </header>

  <div class="open-source__controls" role="group" aria-label="Sort open-source projects">
    <button type="button" data-project-sort="stars" aria-pressed="true">Most stars</button>
    <button type="button" data-project-sort="recent" aria-pressed="false">Recent</button>
  </div>

  <p class="open-source__status" role="status" aria-live="polite">Loading repositories from GitHub…</p>
  <div class="open-source__list" aria-busy="true"></div>
  <nav class="open-source__pagination" aria-label="Repository pages" hidden>
    <button type="button" data-project-page="previous">← Previous</button>
    <span></span>
    <button type="button" data-project-page="next">Next →</button>
  </nav>
</section>

<script>
  interface Repository {
    id: number;
    name: string;
    description: string | null;
    html_url: string;
    stargazers_count: number;
    created_at: string;
    topics: string[];
    fork: boolean;
  }

  document.querySelectorAll<HTMLElement>("[data-open-source-projects]").forEach((root) => {
    const list = root.querySelector<HTMLElement>(".open-source__list");
    const status = root.querySelector<HTMLElement>(".open-source__status");
    const pagination = root.querySelector<HTMLElement>(".open-source__pagination");
    const pageLabel = pagination?.querySelector("span");
    const sortButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-project-sort]")];
    const previous = root.querySelector<HTMLButtonElement>("[data-project-page='previous']");
    const next = root.querySelector<HTMLButtonElement>("[data-project-page='next']");
    const perPage = 7;
    let repositories: Repository[] = [];
    let sort: "stars" | "recent" = "stars";
    let page = 1;

    if (!list || !status || !pagination || !pageLabel || !previous || !next) return;

    const pill = (label: string) => {
      const element = document.createElement("span");
      const tone = [...label].reduce((total, character) => total + character.charCodeAt(0), 0) % 7;
      element.className = `tag-pill tag-pill--${tone}`;
      element.textContent = label;
      return element;
    };

    const render = () => {
      const sorted = [...repositories].sort((a, b) => sort === "stars"
        ? b.stargazers_count - a.stargazers_count
        : new Date(b.created_at).valueOf() - new Date(a.created_at).valueOf());
      const pages = Math.max(1, Math.ceil(sorted.length / perPage));
      page = Math.min(page, pages);
      const visible = sorted.slice((page - 1) * perPage, page * perPage);
      list.replaceChildren();

      visible.forEach((repository) => {
        const article = document.createElement("article");
        article.className = "repository-entry";
        const heading = document.createElement("div");
        heading.className = "repository-entry__heading";
        const link = document.createElement("a");
        link.href = repository.html_url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = repository.name;
        const stars = document.createElement("span");
        stars.textContent = `${repository.stargazers_count} ${repository.stargazers_count === 1 ? "star" : "stars"}`;
        heading.append(link, stars);
        const description = document.createElement("p");
        description.textContent = repository.description ?? "Open-source repository and working experiment.";
        const tags = document.createElement("div");
        tags.className = "tag-list";
        repository.topics.slice(0, 4).forEach((topic) => tags.append(pill(topic)));
        article.append(heading, description);
        if (tags.childElementCount) article.append(tags);
        list.append(article);
      });

      list.setAttribute("aria-busy", "false");
      status.textContent = `${repositories.length} public repositories, sorted by ${sort === "stars" ? "stars" : "recency"}.`;
      pagination.hidden = pages <= 1;
      pageLabel.textContent = `Page ${page} of ${pages}`;
      previous.disabled = page === 1;
      next.disabled = page === pages;
    };

    sortButtons.forEach((button) => button.addEventListener("click", () => {
      sort = button.dataset.projectSort === "recent" ? "recent" : "stars";
      page = 1;
      sortButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      render();
    }));
    previous.addEventListener("click", () => { page = Math.max(1, page - 1); render(); });
    next.addEventListener("click", () => { page += 1; render(); });

    fetch("https://api.github.com/users/blackprince001/repos?per_page=100&sort=created", {
      headers: { Accept: "application/vnd.github+json" },
    })
      .then((response) => {
        if (!response.ok) throw new Error(`GitHub returned ${response.status}`);
        return response.json() as Promise<Repository[]>;
      })
      .then((data) => {
        repositories = data.filter((repository) => !repository.fork);
        render();
      })
      .catch(() => {
        list.setAttribute("aria-busy", "false");
        status.textContent = "Repositories could not be loaded right now.";
        const fallback = document.createElement("a");
        fallback.className = "text-link";
        fallback.href = "https://github.com/blackprince001?tab=repositories";
        fallback.target = "_blank";
        fallback.rel = "noopener noreferrer";
        fallback.textContent = "Browse repositories on GitHub ↗";
        list.replaceChildren(fallback);
      });
  });
</script>
