---
import ArrowRightIcon from "./ArrowRightIcon.astro";

interface Props {
  title: string;
  href: string;
  label?: string;
  headingId: string;
}

const { title, href, label = "View all", headingId } = Astro.props;
---

<div class="section-heading">
  <div>
    <h2 id={headingId}>{title}</h2>
  </div>
  <a href={href} class="text-link">
    <span>{label}</span>
    <ArrowRightIcon />
  </a>
</div>
