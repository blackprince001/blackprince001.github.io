---
import type { FlagshipMetric } from "../../lib/flagship-stories";

interface Props { metrics: FlagshipMetric[] }
const { metrics } = Astro.props;
---

<dl class="metric-group">
  {metrics.map((metric) => <div><dt><strong>{metric.value}</strong><span>{metric.label}</span></dt><dd>{metric.context}</dd></div>)}
</dl>
