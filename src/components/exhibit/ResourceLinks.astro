---
import type { FlagshipResource } from "../../lib/flagship-stories";

interface Props { resources: FlagshipResource[] }
const { resources } = Astro.props;
---

<nav class="exhibit-resources" aria-label="Project resources">
  {resources.map((resource) => {
    const external = resource.url.startsWith("http");
    return <a href={resource.url} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>{resource.label}<span aria-hidden="true">↗</span></a>;
  })}
</nav>
