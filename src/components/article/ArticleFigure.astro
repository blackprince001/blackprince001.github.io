---
import { getImage, Image, type ImageMetadata } from "astro:assets";
import katex from "katex";

interface Props {
  title?: string;
  src?: string;
  srcs?: string[];
  alt?: string;
  caption?: unknown;
  cols?: 1 | 2 | 3 | 4;
}

interface AstroJsxNode {
  type?: unknown;
  props?: { children?: unknown };
  [key: string]: unknown;
}

const { title, src, srcs, alt = "Article figure", caption, cols } = Astro.props;
const media = srcs?.length ? srcs : src ? [src] : [];
const normalizeSrc = (value: string) => value.replace(/^\.\.\//, "").replace(/^\/+/, "");
const articleAssets = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/article/**/*.{avif,gif,jpeg,jpg,png,webp}",
  { eager: true },
);
const optimizedMedia = await Promise.all(media.map(async (item) => {
  const normalized = normalizeSrc(item);
  const assetKey = `../../assets/article/${normalized}`;
  const asset = articleAssets[assetKey]?.default;

  if (!asset) {
    throw new Error(`Article figure "${item}" is not available in src/assets/article.`);
  }

  const maximumWidth = Math.min(asset.width, 1600);
  const widths = [...new Set(
    [480, 768, 1024, 1280, maximumWidth].filter((width) => width <= maximumWidth),
  )].sort((a, b) => a - b);
  const full = await getImage({
    src: asset,
    width: maximumWidth,
    format: "webp",
    quality: 82,
  });

  return { asset, full, maximumWidth, widths };
}));
const columnCount = cols ?? Math.min(media.length, 4);
const sizes = `(max-width: 52rem) calc(100vw - 2.5rem), ${Math.ceil(68 / columnCount)}rem`;
const allowedCaptionTags = new Set(["strong", "em", "code", "span", "br"]);
const escapeHtml = (value: string) => value
  .replaceAll("&", "&amp;")
  .replaceAll("<", "&lt;")
  .replaceAll(">", "&gt;")
  .replaceAll('"', "&quot;")
  .replaceAll("'", "&#039;");
const renderText = (value: string) => {
  let cursor = 0;
  let html = "";

  for (const match of value.matchAll(/\$([^$]+)\$/g)) {
    const index = match.index ?? 0;
    html += escapeHtml(value.slice(cursor, index));
    html += katex.renderToString(match[1], { throwOnError: false, output: "html" });
    cursor = index + match[0].length;
  }

  return html + escapeHtml(value.slice(cursor));
};
const renderCaption = (value: unknown): string => {
  if (value === null || value === undefined || value === false) return "";
  if (typeof value === "string" || typeof value === "number") return renderText(String(value));
  if (Array.isArray(value)) return value.map(renderCaption).join("");
  if (typeof value !== "object") return "";

  const node = value as AstroJsxNode;
  const children = renderCaption(node.props?.children);
  const tag = typeof node.type === "string" && allowedCaptionTags.has(node.type)
    ? node.type
    : undefined;

  if (!tag) return children;
  if (tag === "br") return "<br>";
  return `<${tag}>${children}</${tag}>`;
};
const captionHtml = renderCaption(caption);
---

{media.length > 0 && (
  <figure class="article-figure">
    {title && <p class="article-figure__title">{title}</p>}
    <div class="article-figure__media" style={`--figure-columns: ${columnCount}`}>
      {optimizedMedia.map(({ asset, full, maximumWidth, widths }, index) => (
        <button
          class="article-figure__trigger"
          type="button"
          data-figure-index={index}
          data-figure-full-src={full.src}
          aria-label={`Enlarge ${media.length > 1 ? `${alt} (${index + 1})` : alt}`}
        >
          <Image
            class="article-figure__image"
            src={asset}
            alt={media.length > 1 ? `${alt} (${index + 1})` : alt}
            width={maximumWidth}
            widths={widths}
            sizes={sizes}
            format="webp"
            quality={82}
            loading="lazy"
            decoding="async"
          />
        </button>
      ))}
    </div>
    {captionHtml && <figcaption set:html={captionHtml} />}
    <dialog class="article-figure__dialog" aria-label={`${alt} image viewer`}>
      <div class="article-figure__dialog-frame">
        <button class="article-figure__dialog-close" type="button" data-figure-close aria-label="Close image viewer">Close</button>
        {media.length > 1 && <button class="article-figure__dialog-previous" type="button" data-figure-previous aria-label="Previous image">←</button>}
        <img
          data-figure-dialog-image
          width={optimizedMedia[0].full.attributes.width}
          height={optimizedMedia[0].full.attributes.height}
          alt={media.length > 1 ? `${alt} (1)` : alt}
          decoding="async"
        />
        {media.length > 1 && <button class="article-figure__dialog-next" type="button" data-figure-next aria-label="Next image">→</button>}
        {media.length > 1 && <p data-figure-count>1 / {media.length}</p>}
      </div>
    </dialog>
  </figure>
)}

<script>
  document.querySelectorAll<HTMLElement>(".article-figure").forEach((figure) => {
    if (figure.dataset.viewerReady) return;
    figure.dataset.viewerReady = "true";

    const dialog = figure.querySelector<HTMLDialogElement>(".article-figure__dialog");
    const dialogImage = figure.querySelector<HTMLImageElement>("[data-figure-dialog-image]");
    const triggers = Array.from(figure.querySelectorAll<HTMLButtonElement>("[data-figure-index]"));
    const count = figure.querySelector<HTMLElement>("[data-figure-count]");
    if (!dialog || !dialogImage || triggers.length === 0) return;

    let activeIndex = 0;
    let opener: HTMLButtonElement | null = null;
    const showImage = (index: number) => {
      activeIndex = (index + triggers.length) % triggers.length;
      const image = triggers[activeIndex].querySelector<HTMLImageElement>("img");
      if (!image) return;
      dialogImage.src = triggers[activeIndex].dataset.figureFullSrc || image.currentSrc || image.src;
      dialogImage.alt = image.alt;
      if (count) count.textContent = `${activeIndex + 1} / ${triggers.length}`;
    };
    const open = (trigger: HTMLButtonElement, index: number) => {
      opener = trigger;
      const sourceImage = trigger.querySelector<HTMLImageElement>("img");
      const reveal = () => {
        showImage(index);
        dialog.showModal();
      };

      if (document.startViewTransition && sourceImage && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        sourceImage.style.viewTransitionName = "article-figure-expand";
        const transition = document.startViewTransition(() => {
          reveal();
          sourceImage.style.viewTransitionName = "";
          dialogImage.style.viewTransitionName = "article-figure-expand";
        });
        transition.finished.finally(() => {
          sourceImage.style.viewTransitionName = "";
          dialogImage.style.viewTransitionName = "";
        });
      } else {
        reveal();
      }
    };

    triggers.forEach((trigger, index) => trigger.addEventListener("click", () => open(trigger, index)));
    dialog.querySelector<HTMLButtonElement>("[data-figure-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector<HTMLButtonElement>("[data-figure-previous]")?.addEventListener("click", () => showImage(activeIndex - 1));
    dialog.querySelector<HTMLButtonElement>("[data-figure-next]")?.addEventListener("click", () => showImage(activeIndex + 1));
    dialog.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener("close", () => opener?.focus());
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "Escape") dialog.close();
      if (event.key === "ArrowLeft") showImage(activeIndex - 1);
      if (event.key === "ArrowRight") showImage(activeIndex + 1);
    });
  });
</script>
