---
import "katex/dist/katex.min.css";
import "../styles/islands.css";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  tag: string;
  pathname: string;
}

const { title, description, publishDate, tag, pathname } = Astro.props;
const formattedDate = publishDate.toLocaleDateString("en", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<BaseLayout title={`${title} | blackprince`} description={description ?? `${title}, by Prince Kwabena Appiah Boadu.`} pathname={pathname}>
  <article class="article-shell">
    <header class="article-header">
      <a class="article-back" href="/blog">← Writing</a>
      <p>{tag} · <time datetime={publishDate.toISOString()}>{formattedDate}</time></p>
      <h1>{title}</h1>
    </header>
    <div class="article-body"><slot /></div>
  </article>
</BaseLayout>
