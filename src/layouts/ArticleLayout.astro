---
import "katex/dist/katex.min.css";
import "../styles/islands.css";
import ArticleComments from "../components/article/ArticleComments.astro";
import FloatingToc from "../components/astro/FloatingToc.astro";
import ReturnArrowIcon from "../components/astro/ReturnArrowIcon.astro";
import TagPill from "../components/astro/TagPill.astro";
import type { ArticleDiscoveryLink } from "../lib/content-presentation";
import { getSocialImagePath } from "../lib/social-images";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  tags: string[];
  headings?: { depth: number; slug: string; text: string }[];
  pathname: string;
  backHref?: string;
  backLabel?: string;
  readingTime?: string;
  discoveryLinks?: ArticleDiscoveryLink[];
}

const {
  title,
  description,
  publishDate,
  tags,
  headings = [],
  pathname,
  backHref = "/blog",
  backLabel = "Writing",
  readingTime,
  discoveryLinks = [],
} = Astro.props;
const resolvedDescription = description ?? `${title}, by Prince Kwabena Appiah Boadu.`;
const formattedDate = publishDate.toLocaleDateString("en", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
const canonical = new URL(pathname, Astro.site);
const socialImage = new URL(getSocialImagePath(pathname), Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: resolvedDescription,
  datePublished: publishDate.toISOString(),
  mainEntityOfPage: canonical.href,
  image: socialImage.href,
  keywords: tags.join(", "),
  author: {
    "@type": "Person",
    name: "Prince Kwabena Appiah Boadu",
    url: new URL("/", Astro.site).href,
  },
};
---

<BaseLayout
  title={`${title} | blackprince`}
  description={resolvedDescription}
  pathname={pathname}
  pageType="article"
  publishDate={publishDate}
  tags={tags}
  structuredData={structuredData}
>
  <article class="article-shell">
    <header class="article-header">
      <a class="article-back" href={backHref}>
        <ReturnArrowIcon />
        <span>{backLabel}</span>
      </a>
      <div class="article-title-row">
        <h1>{title}</h1>
        <div class="tag-list">{tags.map((tag: string) => <TagPill label={tag} />)}</div>
      </div>
      <div class="article-meta">
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
        {readingTime && <span>{readingTime}</span>}
      </div>
    </header>
    <div class="article-body"><slot /></div>
    {discoveryLinks.length > 0 && (
      <nav class="article-discovery" aria-label="Continue reading">
        <p class="section-index">Continue reading</p>
        <div>
          {discoveryLinks.map((link) => (
            <a href={link.href}>
              <span>{link.label}</span>
              <strong>{link.title}</strong>
            </a>
          ))}
        </div>
      </nav>
    )}
    <ArticleComments />
  </article>
  <FloatingToc headings={headings} />
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLVideoElement>(".article-body video")
    .forEach((video) => {
      const setShape = (width: number, height: number) => {
        if (!width || !height) return;
        const ratio = width / height;
        video.dataset.mediaShape =
          ratio >= 1.2 ? "landscape" : ratio <= 0.82 ? "portrait" : "square";
      };

      if (video.poster) {
        const poster = new Image();
        poster.addEventListener(
          "load",
          () => setShape(poster.naturalWidth, poster.naturalHeight),
          { once: true },
        );
        poster.src = video.poster;
      }
      video.addEventListener("loadedmetadata", () =>
        setShape(video.videoWidth, video.videoHeight),
      );
    });

  // Collapsible footnotes (how-minds-change and any future article with GFM
  // footnotes): collapsed by default to the first few entries; the toggle, or
  // clicking any in-text footnote reference, expands the whole section.
  // No-JS: every footnote is already in the DOM, so the list just stays open.
  (function () {
    var articleBody = document.querySelector(".article-body");
    if (!articleBody) return;
    var section = articleBody.querySelector("section.footnotes");
    var list = section && section.querySelector("ol");
    if (!section || !list) return;

    var items = list.querySelectorAll("li");
    // Leave short lists alone.
    if (items.length <= 3) return;

    var total = items.length;
    var button = document.createElement("button");
    button.type = "button";
    button.className = "footnotes__toggle";
    button.setAttribute("aria-expanded", "false");
    button.textContent = "Show all " + total + " footnotes";

    // Insert the toggle directly above the list (after the section heading).
    var heading = section.querySelector("h2");
    (heading || list).insertAdjacentElement("afterend", button);

    var setCollapsed = function (collapsed) {
      section.classList.toggle("footnotes--collapsed", collapsed);
      button.setAttribute("aria-expanded", String(!collapsed));
      button.textContent = collapsed
        ? "Show all " + total + " footnotes"
        : "Show fewer footnotes";
    };

    setCollapsed(true);
    button.addEventListener("click", function () {
      setCollapsed(!section.classList.contains("footnotes--collapsed"));
    });

    // Clicking any in-text footnote reference expands the whole section so the
    // jumped-to citation is immediately visible. Capture phase runs before the
    // default anchor scroll lands on the (currently hidden) list item.
    document.addEventListener(
      "click",
      function (event) {
        var target = event.target;
        if (
          section.classList.contains("footnotes--collapsed") &&
          target &&
          target.closest &&
          target.closest("a[data-footnote-ref]")
        ) {
          setCollapsed(false);
        }
      },
      true,
    );
  })();
</script>
