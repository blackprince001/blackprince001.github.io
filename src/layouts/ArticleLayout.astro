---
import "katex/dist/katex.min.css";
import "../styles/islands.css";
import ArticleComments from "../components/article/ArticleComments.astro";
import FloatingToc from "../components/astro/FloatingToc.astro";
import ReturnArrowIcon from "../components/astro/ReturnArrowIcon.astro";
import TagPill from "../components/astro/TagPill.astro";
import type { ArticleDiscoveryLink } from "../lib/content-presentation";
import { getSocialImagePath } from "../lib/social-images";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  publishDate: Date;
  tags: string[];
  headings?: { depth: number; slug: string; text: string }[];
  pathname: string;
  backHref?: string;
  backLabel?: string;
  readingTime?: string;
  discoveryLinks?: ArticleDiscoveryLink[];
}

const {
  title,
  description,
  publishDate,
  tags,
  headings = [],
  pathname,
  backHref = "/blog",
  backLabel = "Writing",
  readingTime,
  discoveryLinks = [],
} = Astro.props;
const resolvedDescription = description ?? `${title}, by Prince Kwabena Appiah Boadu.`;
const formattedDate = publishDate.toLocaleDateString("en", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
const canonical = new URL(pathname, Astro.site);
const socialImage = new URL(getSocialImagePath(pathname), Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: resolvedDescription,
  datePublished: publishDate.toISOString(),
  mainEntityOfPage: canonical.href,
  image: socialImage.href,
  keywords: tags.join(", "),
  author: {
    "@type": "Person",
    name: "Prince Kwabena Appiah Boadu",
    url: new URL("/", Astro.site).href,
  },
};
---

<BaseLayout
  title={`${title} | blackprince`}
  description={resolvedDescription}
  pathname={pathname}
  pageType="article"
  publishDate={publishDate}
  tags={tags}
  structuredData={structuredData}
>
  <article class="article-shell">
    <header class="article-header">
      <a class="article-back" href={backHref}>
        <ReturnArrowIcon />
        <span>{backLabel}</span>
      </a>
      <div class="article-title-row">
        <h1>{title}</h1>
        <div class="tag-list">{tags.map((tag: string) => <TagPill label={tag} />)}</div>
      </div>
      <div class="article-meta">
        <time datetime={publishDate.toISOString()}>{formattedDate}</time>
        {readingTime && <span>{readingTime}</span>}
      </div>
    </header>
    <div class="article-body"><slot /></div>
    {discoveryLinks.length > 0 && (
      <nav class="article-discovery" aria-label="Continue reading">
        <p class="section-index">Continue reading</p>
        <div>
          {discoveryLinks.map((link) => (
            <a href={link.href}>
              <span>{link.label}</span>
              <strong>{link.title}</strong>
            </a>
          ))}
        </div>
      </nav>
    )}
    <ArticleComments />
  </article>
  <FloatingToc headings={headings} />
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLVideoElement>(".article-body video")
    .forEach((video) => {
      const setShape = (width: number, height: number) => {
        if (!width || !height) return;
        const ratio = width / height;
        video.dataset.mediaShape =
          ratio >= 1.2 ? "landscape" : ratio <= 0.82 ? "portrait" : "square";
      };

      if (video.poster) {
        const poster = new Image();
        poster.addEventListener(
          "load",
          () => setShape(poster.naturalWidth, poster.naturalHeight),
          { once: true },
        );
        poster.src = video.poster;
      }
      video.addEventListener("loadedmetadata", () =>
        setShape(video.videoWidth, video.videoHeight),
      );
    });
</script>
