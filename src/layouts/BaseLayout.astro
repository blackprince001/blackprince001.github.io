---
import "@fontsource-variable/inter/standard.css";
import "@fontsource-variable/inter/standard-italic.css";
import "@fontsource-variable/ibm-plex-sans/standard.css";
import "@fontsource-variable/ibm-plex-sans/standard-italic.css";
import "../styles/global.css";
import ReturnArrowIcon from "../components/astro/ReturnArrowIcon.astro";
import { getSocialImagePath } from "../lib/social-images";

interface Props {
  title?: string;
  description?: string;
  pathname?: string;
  robots?: string;
  pageType?: "website" | "article";
  publishDate?: Date;
  tags?: string[];
  structuredData?: Record<string, unknown>;
  socialImagePath?: string;
  socialImageAlt?: string;
}

const {
  title = "blackprince | Nebula",
  description = "Engineering journal of Prince Kwabena Appiah Boadu.",
  pathname = Astro.url.pathname,
  robots,
  pageType = "website",
  publishDate,
  tags = [],
  structuredData,
  socialImagePath,
  socialImageAlt,
} = Astro.props;
const canonical = new URL(pathname, Astro.site);
const normalizedPath = pathname.replace(/\/+$/, "") || "/";
const resolvedSocialImagePath = socialImagePath ?? getSocialImagePath(normalizedPath);
const socialImage = new URL(resolvedSocialImagePath, Astro.site);
const resolvedSocialImageAlt =
  socialImageAlt ?? `Editorial social preview for ${title.replace(/\s*[|—]\s*blackprince$/, "")}`;
const isHome = normalizedPath === "/";
const isBlogArticle = normalizedPath.startsWith("/blog/");
const isShortArticle = normalizedPath.startsWith("/shorts/") && !normalizedPath.startsWith("/shorts/tag/");
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replaceAll("<", "\\u003c")
  : undefined;

const nav = [
  { label: "Writing", href: "/blog", section: "/blog" },
  { label: "Shorts", href: "/shorts", section: "/shorts" },
  { label: "Projects", href: "/projects", section: "/projects" },
  { label: "Manuscripts", href: "/publications", section: "/publications" },
  { label: "Reading", href: "/reading", section: "/reading" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="blackprince — Writing" href="/rss.xml" />
    {pageType === "article" && <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="blackprince" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={resolvedSocialImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={pageType} />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={resolvedSocialImageAlt} />
    <title>{title}</title>
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson} />}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const saved = localStorage.getItem("theme");
        const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = saved === "light" || saved === "dark" ? saved : systemDark ? "dark" : "light";
        if (saved === "light" || saved === "dark") root.dataset.theme = saved;
        root.classList.toggle("dark", theme === "dark");
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={["site-frame", { "site-frame--with-nav": isHome }]}>
      {isHome && (
        <nav class="site-nav" aria-label="Primary navigation" data-menu-open="false">
          <a class="site-nav__home" href="/" aria-current="page">Home</a>
          <button class="site-nav__menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation-menu" aria-label="Open navigation menu">
            <svg aria-hidden="true" viewBox="0 0 18 18" width="18" height="18"><path d="M3 5h12M3 9h12M3 13h12" /></svg>
          </button>
          <div class="site-nav__menu" id="primary-navigation-menu">
            {nav.map(({ label, href }) => <a href={href}>{label}</a>)}
          </div>
        </nav>
      )}
      <div class="site-content">
        <main id="main-content">
          {!isHome && !isBlogArticle && !isShortArticle && (
            <a class="page-home-link" href="/">
              <ReturnArrowIcon />
              <span>Home</span>
            </a>
          )}
          <button class="theme-toggle page-theme-toggle" type="button" aria-label="Toggle color theme">
            <svg class="theme-icon theme-icon--moon" aria-hidden="true" viewBox="0 0 16 16" width="16" height="18"><path d="M13.1 10.35A5.75 5.75 0 0 1 5.65 2.9 5.75 5.75 0 1 0 13.1 10.35Z" /></svg>
            <svg class="theme-icon theme-icon--sun" aria-hidden="true" viewBox="0 0 16 16" width="16" height="18"><circle cx="8" cy="8" r="2.5" /><path d="M8 1v1.25M8 13.75V15M1 8h1.25M13.75 8H15M3.05 3.05l.9.9M12.05 12.05l.9.9M12.95 3.05l-.9.9M3.95 12.05l-.9.9" /></svg>
          </button>
          <slot />
        </main>
        <footer class="site-footer">
          <span>Prince Kwabena Appiah Boadu</span>
          <span>Systems · AI/Robotics · Learning</span>
        </footer>
      </div>
    </div>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const updateThemeButton = () => {
        if (!button) return;
        const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
        button.setAttribute("aria-label", `Switch to ${nextTheme} theme`);
        button.title = `Switch to ${nextTheme} theme`;
      };
      updateThemeButton();
      button?.addEventListener("click", () => {
        const root = document.documentElement;
        const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const current = root.dataset.theme ?? (systemDark ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        root.classList.toggle("dark", next === "dark");
        localStorage.setItem("theme", next);
        updateThemeButton();
      });

      const navigation = document.querySelector<HTMLElement>(".site-nav");
      const menuToggle = document.querySelector<HTMLButtonElement>(".site-nav__menu-toggle");
      const menu = document.querySelector<HTMLElement>(".site-nav__menu");
      const setMenuOpen = (open: boolean) => {
        if (!navigation || !menuToggle) return;
        navigation.dataset.menuOpen = String(open);
        menuToggle.setAttribute("aria-expanded", String(open));
        menuToggle.setAttribute("aria-label", open ? "Close navigation menu" : "Open navigation menu");
      };
      menuToggle?.addEventListener("click", () => setMenuOpen(navigation?.dataset.menuOpen !== "true"));
      menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)));
      document.addEventListener("click", (event) => {
        if (navigation && !navigation.contains(event.target as Node)) setMenuOpen(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && navigation?.dataset.menuOpen === "true") {
          setMenuOpen(false);
          menuToggle?.focus();
        }
      });

    </script>
  </body>
</html>
